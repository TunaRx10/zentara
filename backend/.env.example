# Zentara Backend — Env vars for Koyeb deployment
# Copy these into Koyeb dashboard → Service → Environment Variables

# Port (Koyeb sets PORT automatically, fallback to 4000)
PORT=4000

# AI Provider (NVIDIA NIM)
NVIDIA_API_KEY=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
AI_PROVIDER=nvidia
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# LinkedIn (optional — StaffSpy via Python bridge)
# LINKEDIN_USERNAME=your@email.com
# LINKEDIN_PASSWORD=your_password
# LINKEDIN_SESSION_FILE=/app/data/linkedin-session.pkl

# Python
PYTHON=python3
LISTEN_HOST=0.0.0.0

# SQLite path
ZENTARA_DB_PATH=/app/data/zentara.db