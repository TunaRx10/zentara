# =============================================================================
# Zentara — Frontend environment (Vite)
# =============================================================================
# Copier ce fichier en `.env.local` pour activer un autre backend.
#
# Vite lit UNIQUEMENT les variables préfixées par VITE_ et les expose côté
# client via `import.meta.env.*` (cf. `src/vite-env.d.ts`).
# =============================================================================

# URL complète du backend Zentara incluant /api.
# Exemples :
#   - Dev local     : http://localhost:4000/api
#   - Production    : https://zentara.example.com/api
#   - LAN (mobile)  : http://192.168.1.20:4000/api
VITE_API_BASE_URL=http://localhost:4000/api

# Activer le sync hybride (true par défaut). Si false, le frontend reste
# strictement offline-first (CRUD local uniquement, pas d'appel API).
VITE_SYNC_ENABLED=true

# Timeout par défaut des appels API en ms.
VITE_API_TIMEOUT_MS=30000
